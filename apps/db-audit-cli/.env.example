# DB Audit CLI example environment.
# Copy this file to your shell environment or source it before running the binary.
# Do not commit real credentials.

# Default model provider.
# Other supported providers include ollama, ollama-cloud, browser,
# transformer, transformer-browser, webllm, and anthropic.
AGENT_PROVIDER=azure
AZURE_OPENAI_DEPLOYMENT=gpt-5.2-codex
AZURE_RESOURCE_NAME=your_azure_resource_name
AZURE_API_KEY=your_azure_api_key
# Optional: set if your Azure OpenAI deployment uses a custom base URL or API version.
# AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/gpt-5.2-codex
# AZURE_API_VERSION=2024-12-01-preview

# Optional: override the default dump directory used when --dump is omitted.
# QWERY_GFS_DUMPS_DIR=/home/you/.cache/qwery/gfs-dumps

# Optional: override where GFS audit work directories are created.
# QWERY_GFS_AUDITS_DIR=/tmp/db-audit/gfs

# Optional: override psql binary discovery.
# QWERY_PSQL_BIN=psql
