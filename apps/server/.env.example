
# Storage
QWERY_STORAGE_DIR=qwery.db

# Extensions discovery
QWERY_EXTENSIONS_PATH=

# Azure OpenAI
AZURE_API_KEY=
AZURE_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=gpt-5.2-codex

# Anthropic
ANTHROPIC_API_KEY=

# PostgreSQL datasource query timeout in milliseconds. Slow-query optimizer
# diagnostics may need longer than the default 30s connection-test timeout.
QWERY_POSTGRES_OPERATION_TIMEOUT_MS=120000

# Ollama Cloud
AGENT_PROVIDER=ollama-cloud
OLLAMA_API_KEY=
OLLAMA_MODEL=minimax-m2.7

# Telemetry
QWERY_TELEMETRY_ENABLED=false
QWERY_TELEMETRY_DEBUG=false

# Default model
DEFAULT_MODEL=azure/gpt-5.2-codex
